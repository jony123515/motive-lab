# ====================================================================
# MOTIVE LAB - Variables de Entorno de Configuración
# ====================================================================

# Next.js Public Environment Variables
NEXT_PUBLIC_APP_NAME="MOTIVE LAB"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase PostgreSQL Configuration (Opcional en modo Demo, Obligatorio en Producción)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Solo para Server Actions y Admin API)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cifrado y Seguridad
ENCRYPTION_SECRET_KEY=generate-a-strong-32-byte-secret-key-for-health-data
